---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";

const navItems = [
  { label: "Proyek", href: isHome ? "#projects" : "/#projects" },
  { label: "Tentang", href: isHome ? "#about" : "/#about" },
  { label: "Keahlian", href: isHome ? "#skills" : "/#skills" },
  { label: "Pengalaman", href: isHome ? "#experience" : "/#experience" },
  { label: "Kontak", href: isHome ? "#contact" : "/#contact" },
];
---

<header class="site-header">
  <div class="container header-container">
    <a
      href="/"
      class="brand-link"
      aria-label="Beranda Muhammad Elang Prakoso - prakosoee"
    >
      <img
        src="/images/prakosoee-dark.webp"
        alt="prakosoee"
        class="brand-logo"
        width="114"
        height="38"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigasi Utama">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-action">
      <a
        href={isHome ? "#contact" : "/#contact"}
        class="btn-primary header-cta"
      >
        Hubungi Saya
      </a>

      <!-- Mobile Menu Toggle Button (minimum 44x44px target) -->
      <button
        id="mobile-menu-toggle"
        class="menu-toggle-btn"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer / Menu -->
  <div id="mobile-nav-menu" class="mobile-nav" hidden>
    <div class="container mobile-nav-content">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-cta-wrapper">
        <a
          href={isHome ? "#contact" : "/#contact"}
          class="btn-primary mobile-cta"
        >
          Hubungi Saya
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-nav-menu");
    const mobileLinks = document.querySelectorAll(
      ".mobile-nav-link, .mobile-cta",
    );

    if (!toggleBtn || !menu) return;

    function openMenu() {
      toggleBtn.setAttribute("aria-expanded", "true");
      toggleBtn.setAttribute("aria-label", "Tutup menu navigasi");
      menu.hidden = false;
      menu.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      toggleBtn.setAttribute("aria-expanded", "false");
      toggleBtn.setAttribute("aria-label", "Buka menu navigasi");
      menu.hidden = true;
      menu.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close menu when Escape key is pressed
    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggleBtn.getAttribute("aria-expanded") === "true"
      ) {
        closeMenu();
        toggleBtn.focus();
      }
    });
  }

  // Setup on page load and handle Astro page transitions
  document.addEventListener("DOMContentLoaded", setupMobileMenu);
  setupMobileMenu();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    border-bottom: 1px dashed var(--color-border-dashed, #cbd5e1);
    transition: border-color 0.15s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    border-left: 1px dotted var(--color-border-dotted, #94a3b8);
    border-right: 1px dotted var(--color-border-dotted, #94a3b8);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .brand-link:hover {
    text-decoration: none;
    opacity: 0.88;
  }

  .brand-logo {
    height: 32px;
    width: auto;
    max-height: 36px;
    object-fit: contain;
    display: block;
  }

  @media (min-width: 640px) {
    .brand-logo {
      height: 35px;
    }
  }

  .desktop-nav {
    display: flex;
    align-items: stretch;
    align-self: stretch;
    height: 100%;
    padding: 0;
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    height: 100%;
    list-style: none;
    gap: 0;
    margin: 0;
    padding: 0;
    border-left: 1px dotted var(--color-border-dotted, #94a3b8);
  }

  .nav-list li {
    display: flex;
    align-items: stretch;
    height: 100%;
    border-right: 1px dotted var(--color-border-dotted, #94a3b8);
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 clamp(16px, 1.8vw, 24px);
    color: #334155;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    border: none;
    border-radius: 0;
    background: transparent;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .nav-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    text-decoration: none;
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header-cta {
    height: 40px;
    padding: 0 18px;
    font-size: 13px;
    border-radius: 0;
  }

  /* Hamburger Menu Button */
  .menu-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1px solid var(--color-neutral);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .menu-toggle-btn:hover {
    background-color: var(--color-tertiary);
  }

  .menu-bar {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-on-surface);
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  /* Mobile Nav Drawer */
  .mobile-nav {
    display: none;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ffffff;
    border-top: 1px solid var(--color-neutral);
    z-index: 49;
    overflow-y: auto;
  }

  .mobile-nav.is-open {
    display: block;
  }

  .mobile-nav-content {
    padding-top: var(--space-md);
    padding-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mobile-nav-link {
    display: block;
    padding: 14px 16px;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-on-surface);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-height: 44px;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-tertiary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .mobile-cta-wrapper {
    padding-top: var(--space-sm);
  }

  .mobile-cta {
    width: 100%;
  }

  /* Responsive Breakpoint */
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .menu-toggle-btn {
      display: flex;
    }
  }
</style>
