---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../types/portfolio';

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : null;
    const nextProject = index < projects.length - 1 ? projects[index + 1] : null;

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject }
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project | null;
  nextProject: Project | null;
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout 
  title={`${project.title} - Studi Kasus`} 
  description={project.summary}
  currentPath={`/projects/${project.slug}`}
>
  <div class="project-detail-page">
    <div class="container">
      <!-- Breadcrumb & Back button -->
      <nav class="detail-nav" aria-label="Navigasi Proyek">
        <a href="/#projects" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Kembali ke Daftar Proyek</span>
        </a>
      </nav>

      <!-- Project Header -->
      <header class="project-detail-header">
        <div class="header-badges">
          <span class="chip">{project.category}</span>
          <span class="chip chip-mono">{project.period}</span>
          <span class="chip chip-status">{project.status}</span>
        </div>

        <h1 class="detail-title">{project.title}</h1>
        <p class="detail-lead">{project.summary}</p>

        <div class="detail-meta-card card">
          <div class="meta-item">
            <span class="meta-label">Peran & Tanggung Jawab</span>
            <span class="meta-value">{project.role}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Teknologi Utama</span>
            <div class="meta-tags">
              {project.technologies.map((tech) => (
                <span class="chip chip-mono">{tech}</span>
              ))}
            </div>
          </div>

          <div class="meta-item meta-actions">
            <span class="meta-label">Aksesibilitas & Tautan</span>
            <div class="action-buttons">
              {project.isPublicRepo && project.repositoryUrl ? (
                <a 
                  href={project.repositoryUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-primary"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                  <span>Buka Repositori GitHub</span>
                </a>
              ) : null}

              {project.isPublicDemo && project.demoUrl ? (
                <a 
                  href={project.demoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-secondary"
                >
                  <span>Lihat Demo Online</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              ) : null}

              {!project.isPublicRepo && project.accessNote && (
                <div class="internal-system-note">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>{project.accessNote}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- Main Case Study Content -->
      <div class="case-study-body">
        <!-- Project Overview -->
        <section class="study-section" aria-labelledby="overview-heading">
          <h2 id="overview-heading" class="study-section-title">Latar Belakang & Masalah</h2>
          <p class="study-paragraph">{project.problem}</p>

          <div class="goals-box card">
            <h3 class="goals-title">Tujuan Teknis Proyek</h3>
            <ul class="study-list">
              {project.goals.map((goal) => (
                <li>{goal}</li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Role & Contribution -->
        <section class="study-section" aria-labelledby="contribution-heading">
          <h2 id="contribution-heading" class="study-section-title">Peran & Kontribusi Nyata</h2>
          <p class="study-paragraph">
            Sebagai {project.role}, kontribusi utama yang saya kerjakan secara langsung mencakup:
          </p>
          <ul class="study-list">
            {project.contributions.map((contribution) => (
              <li>{contribution}</li>
            ))}
          </ul>
        </section>

        <!-- Key Features -->
        <section class="study-section" aria-labelledby="features-heading">
          <h2 id="features-heading" class="study-section-title">Fitur Utama yang Dibangun</h2>
          <div class="features-grid">
            {project.features.map((feature) => (
              <div class="card feature-card">
                <h3 class="feature-title">{feature.title}</h3>
                <p class="feature-desc">{feature.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Technical Implementation -->
        <section class="study-section" aria-labelledby="tech-heading">
          <h2 id="tech-heading" class="study-section-title">Implementasi & Arsitektur Teknis</h2>
          
          <div class="tech-spec-grid">
            {project.technicalImplementation.architecture && (
              <div class="spec-item">
                <h3 class="spec-label">Arsitektur Sistem</h3>
                <p class="spec-text">{project.technicalImplementation.architecture}</p>
              </div>
            )}

            {project.technicalImplementation.backend && (
              <div class="spec-item">
                <h3 class="spec-label">Backend & API</h3>
                <p class="spec-text">{project.technicalImplementation.backend}</p>
              </div>
            )}

            {project.technicalImplementation.database && (
              <div class="spec-item">
                <h3 class="spec-label">Basis Data & Relasi</h3>
                <p class="spec-text">{project.technicalImplementation.database}</p>
              </div>
            )}

            {project.technicalImplementation.pipeline && (
              <div class="spec-item">
                <h3 class="spec-label">Pipeline Data & Model</h3>
                <p class="spec-text">{project.technicalImplementation.pipeline}</p>
              </div>
            )}

            {project.technicalImplementation.frontend && (
              <div class="spec-item">
                <h3 class="spec-label">Frontend & Antarmuka</h3>
                <p class="spec-text">{project.technicalImplementation.frontend}</p>
              </div>
            )}

            {project.technicalImplementation.deployment && (
              <div class="spec-item">
                <h3 class="spec-label">Infrastruktur & Deployment</h3>
                <p class="spec-text">{project.technicalImplementation.deployment}</p>
              </div>
            )}
          </div>
        </section>

        <!-- Challenges & Trade-offs -->
        <section class="study-section" aria-labelledby="challenges-heading">
          <h2 id="challenges-heading" class="study-section-title">Tantangan Teknis & Keputusan Desain</h2>
          <div class="challenges-list">
            {project.challenges.map((c, idx) => (
              <div class="card challenge-card">
                <div class="challenge-header">
                  <span class="challenge-num">Kasus {idx + 1}</span>
                  <h3 class="challenge-title">{c.challenge}</h3>
                </div>

                <div class="challenge-solution">
                  <span class="sub-label">Solusi yang Diambil:</span>
                  <p class="solution-text">{c.solution}</p>
                </div>

                <div class="challenge-tradeoff">
                  <span class="sub-label">Trade-Off & Konsekuensi:</span>
                  <p class="tradeoff-text">{c.tradeOff}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Verifiable Results -->
        <section class="study-section" aria-labelledby="results-heading">
          <h2 id="results-heading" class="study-section-title">Hasil Implementasi & Dampak</h2>
          <div class="results-card card">
            <ul class="study-list">
              {project.results.map((result) => (
                <li>{result}</li>
              ))}
            </ul>
          </div>
        </section>
      </div>

      <!-- Navigation to Previous / Next Project -->
      <nav class="project-pagination" aria-label="Navigasi antar proyek">
        {prevProject ? (
          <a href={`/projects/${prevProject.slug}`} class="card pagination-card prev-card">
            <span class="pagination-sub">Proyek Sebelumnya</span>
            <span class="pagination-title">{prevProject.title}</span>
          </a>
        ) : (
          <div class="pagination-placeholder"></div>
        )}

        {nextProject ? (
          <a href={`/projects/${nextProject.slug}`} class="card pagination-card next-card">
            <span class="pagination-sub">Proyek Selanjutnya</span>
            <span class="pagination-title">{nextProject.title}</span>
          </a>
        ) : (
          <div class="pagination-placeholder"></div>
        )}
      </nav>
    </div>
  </div>
</Layout>

<style>
  .project-detail-page {
    padding-top: var(--space-md);
    padding-bottom: var(--space-xl);
  }

  .detail-nav {
    margin-bottom: var(--space-md);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size-label-lg);
    font-weight: 500;
    color: var(--color-secondary);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
    background-color: var(--color-tertiary);
    text-decoration: none;
  }

  .project-detail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .header-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .chip-status {
    background-color: #ecfdf5;
    color: #065f46;
    border-color: #a7f3d0;
  }

  .detail-title {
    font-size: var(--font-size-headline-lg);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-on-surface);
  }

  .detail-lead {
    font-size: var(--font-size-body-lg);
    color: var(--color-secondary);
    line-height: 1.6;
    max-width: 800px;
  }

  .detail-meta-card {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    padding: 24px;
    background-color: #fafbfc;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-label {
    font-size: var(--font-size-label-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: var(--font-size-body-sm);
    color: var(--color-on-surface);
    font-weight: 500;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .internal-system-note {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--font-size-label-sm);
    color: var(--color-text-muted);
    background-color: #ffffff;
    border: 1px solid var(--color-neutral);
    padding: 10px 12px;
    border-radius: var(--radius-md);
    line-height: 1.4;
  }

  .internal-system-note svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Case study body */
  .case-study-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .study-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-neutral);
  }

  .study-section-title {
    font-size: var(--font-size-headline-md);
    font-weight: 600;
    color: var(--color-on-surface);
  }

  .study-paragraph {
    font-size: var(--font-size-body-md);
    color: var(--color-secondary);
    line-height: 1.7;
    max-width: 820px;
  }

  .goals-box {
    padding: 20px 24px;
    background-color: #f8fafc;
    margin-top: 4px;
  }

  .goals-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-on-surface);
    margin-bottom: 10px;
  }

  .study-list {
    margin-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-secondary);
  }

  .study-list li {
    font-size: var(--font-size-body-md);
    line-height: 1.6;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-sm);
    margin-top: 4px;
  }

  .feature-card {
    padding: 20px;
  }

  .feature-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-on-surface);
    margin-bottom: 6px;
  }

  .feature-desc {
    font-size: var(--font-size-body-sm);
    color: var(--color-secondary);
    line-height: 1.55;
  }

  /* Technical Specs Grid */
  .tech-spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
    margin-top: 4px;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    background-color: #fafbfc;
    border: 1px solid var(--color-neutral);
    border-radius: var(--radius-lg);
  }

  .spec-label {
    font-size: var(--font-size-label-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }

  .spec-text {
    font-size: var(--font-size-body-sm);
    color: var(--color-secondary);
    line-height: 1.55;
  }

  /* Challenges List */
  .challenges-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: 4px;
  }

  .challenge-card {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .challenge-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .challenge-num {
    font-size: var(--font-size-label-sm);
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 600;
  }

  .challenge-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-on-surface);
  }

  .sub-label {
    display: block;
    font-size: var(--font-size-label-sm);
    font-weight: 600;
    color: var(--color-on-surface);
    margin-bottom: 2px;
  }

  .solution-text, .tradeoff-text {
    font-size: var(--font-size-body-sm);
    color: var(--color-secondary);
    line-height: 1.55;
  }

  .results-card {
    padding: 24px;
    background-color: #fafbfc;
  }

  /* Pagination */
  .project-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-neutral);
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    padding: 20px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .pagination-card:hover {
    border-color: var(--color-primary-60);
    background-color: var(--color-tertiary);
    text-decoration: none;
  }

  .prev-card {
    text-align: left;
  }

  .next-card {
    text-align: right;
  }

  .pagination-sub {
    font-size: var(--font-size-label-sm);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .pagination-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-on-surface);
  }

  @media (max-width: 768px) {
    .detail-meta-card {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .project-pagination {
      grid-template-columns: 1fr;
    }

    .next-card {
      text-align: left;
    }
  }
</style>
