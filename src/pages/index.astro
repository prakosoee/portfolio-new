---
import Layout from "../layouts/Layout.astro";
import ProjectShowcaseSection from "../components/ProjectShowcaseSection.astro";
import ExperienceTimelineSection from "../components/ExperienceTimelineSection.astro";
import EducationSection from "../components/EducationSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { personalProfile, socialLinks } from "../data/profile";
import { TechSkillsCloud } from "../components/ui/tech-skills-cloud";
---

<Layout title="Software Engineer & Full-Stack Developer">
  <!-- Hero / Introduction Section -->
  <section class="section section-hero" aria-labelledby="hero-title">
    <div class="container hero-container">
      <div class="hero-content">
        <h1 id="hero-title" class="hero-title">
          {personalProfile.name}
        </h1>

        <p class="hero-subtitle">
          {personalProfile.role}
        </p>

        <p class="hero-bio">
          Software Engineer yang berfokus pada arsitektur sistem backend,
          keandalan basis data relasional, dan rekayasa pipeline data/AI.
          Berpengalaman merekonstruksi sistem pelayanan publik, optimasi
          database skala besar, dan model NLP inferensi cepat.
        </p>

        <div class="hero-actions">
          <a href="#projects" class="btn-primary hero-btn">
            Lihat Studi Kasus
          </a>
          <a href="#contact" class="btn-secondary hero-btn"> Hubungi Saya </a>
        </div>

        <div class="hero-links" aria-label="Tautan profil profesional">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target={link.url.startsWith("http") ? "_blank" : undefined}
                rel={
                  link.url.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                class="hero-social-link"
                aria-label={link.label}
              >
                {link.platform}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work (Interactive Showcase Component) -->
  <ProjectShowcaseSection />

  <!-- About & Principles Section -->
  <section
    id="about"
    class="section section-about"
    aria-labelledby="about-heading"
  >
    <div class="container">
      <div class="about-grid">
        <div class="about-main">
          <h2 id="about-heading" class="section-title">Tentang Saya</h2>
          <div class="about-paragraphs">
            {
              personalProfile.about.map((paragraph) => (
                <p class="about-text">{paragraph}</p>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col items-center w-full">
          <div
            class="w-full max-w-[380px] bg-white border border-slate-200 rounded-[20px] overflow-hidden shadow-[0_10px_30px_-10px_rgba(0,0,0,0.06)] hover:shadow-[0_18px_40px_-12px_rgba(0,0,0,0.1)] hover:-translate-y-0.5 transition-all duration-200 group"
          >
            <div
              class="w-full aspect-[4/4.6] overflow-hidden bg-slate-100 relative"
            >
              <img
                src="/images/profile.jpg"
                alt={personalProfile.name}
                class="w-full h-full object-cover object-top block transition-transform duration-500 group-hover:scale-[1.02]"
                width="400"
                height="500"
                loading="lazy"
              />
            </div>
            <div
              class="px-5 pt-4 pb-5 flex flex-col gap-1.5 border-t border-dashed border-slate-300 bg-white"
            >
              <span
                class="font-['Plus_Jakarta_Sans',sans-serif] text-[18px] font-bold text-slate-900 tracking-[-0.015em]"
                >{personalProfile.name}</span
              >
              <span class="text-[13.5px] text-blue-600 font-medium"
                >{personalProfile.role}</span
              >
              <div
                class="inline-flex items-center gap-2 mt-1.5 text-[12.5px] text-slate-600"
              >
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"
                ></span>
                <span
                  >{personalProfile.location} · {
                    personalProfile.availability
                  }</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Skills Section -->
  <section
    id="skills"
    class="section section-skills"
    aria-labelledby="skills-heading"
  >
    <div class="container">
      <div class="section-header">
        <h2 id="skills-heading" class="section-title">
          Teknologi & Lingkup Penerapan
        </h2>
        <p class="section-description">
          Teknologi yang benar-benar digunakan dalam pengembangan aplikasi,
          arsitektur data, dan riset model.
        </p>
      </div>

      <TechSkillsCloud client:visible />
    </div>
  </section>

  <!-- Experience Timeline Section (Aceternity Interactive Component) -->
  <ExperienceTimelineSection />

  <!-- Education Section -->
  <EducationSection />

  <!-- Contact Section -->
  <ContactSection />
</Layout>

<style>
  /* Hero Section */
  .section-hero {
    border-bottom: 1px dashed var(--color-border-dashed, #cbd5e1);
  }

  .hero-container {
    width: 100%;
    max-width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 820px;
  }

  .hero-availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background-color: var(--color-tertiary);
    border: 1px solid rgba(96, 165, 250, 0.3);
    border-radius: var(--radius-full);
    width: fit-content;
    margin-bottom: 4px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-success);
    border-radius: 50%;
  }

  .availability-text {
    font-size: var(--font-size-label-md);
    color: var(--color-on-surface);
    font-weight: 500;
  }

  .hero-title {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    font-weight: 600;
    color: var(--color-on-surface);
    margin-top: 4px;
  }

  .hero-subtitle {
    font-size: clamp(20px, 3vw, 26px);
    color: var(--color-primary);
    font-weight: 500;
    line-height: 1.3;
  }

  .hero-bio {
    font-size: var(--font-size-body-lg);
    color: var(--color-secondary);
    line-height: 1.65;
    max-width: 720px;
    margin-top: 4px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-xs);
  }

  .hero-btn {
    min-width: 160px;
  }

  .hero-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xs);
    flex-wrap: wrap;
  }

  .hero-social-link {
    font-size: var(--font-size-label-lg);
    font-weight: 500;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-social-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Section Header */
  /* Section Header */
  .section-header {
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 768px;
  }

  .section-title {
    font-family: var(--font-display, "Plus Jakarta Sans", sans-serif);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-on-surface, #111827);
    margin-bottom: 12px;
  }

  .section-description {
    font-size: clamp(14px, 2vw, 17px);
    color: var(--color-secondary, #4b5563);
    line-height: 1.6;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-md);
  }

  /* About Section */
  .section-about {
    border-bottom: 1px dashed var(--color-border-dashed, #cbd5e1);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: flex-start;
  }

  .about-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .about-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: 4px;
    text-align: justify;
  }

  .about-text {
    font-size: var(--font-size-body-md);
    line-height: 1.7;
    color: var(--color-secondary);
  }

  .section-skills {
    border-bottom: 1px dashed var(--color-border-dashed, #cbd5e1);
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-btn {
      width: 100%;
    }
  }
</style>
